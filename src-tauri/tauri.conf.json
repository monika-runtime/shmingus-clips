{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shmingus Clips",
  "version": "0.2.0",
  "identifier": "dev.clipforge.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shmingus Clips",
        "width": 1240,
        "height": 800,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["$HOME/**"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "category": "Video",
    "shortDescription": "Instant game clips on Linux",
    "longDescription": "Shmingus Clips keeps a rolling replay buffer of your screen and audio, and saves the last moments to MP4 when you hit the clip hotkey.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
